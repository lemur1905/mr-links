# Backend Environment Variables
# Railway will auto-provide DATABASE_URL if you add PostgreSQL

# Optional: Enable automatic RSS scraping every hour
ENABLE_RSS_SCHEDULER=true
RSS_UPDATE_INTERVAL_HOURS=1

# Frontend URL for CORS (Railway will auto-assign, or use your custom domain)
FRONTEND_URL=https://your-frontend-name.up.railway.app

# Database (Railway provides this automatically if using PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
